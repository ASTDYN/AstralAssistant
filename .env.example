# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/astralbot

# Discord Channel IDs (right-click channel → Copy ID with Developer Mode enabled)
ADMIN_NOTIFS_CHANNEL_ID=123456789012345678
RECRUITMENT_CHANNEL_ID=123456789012345679
LOBBY_CHANNEL_ID=123456789012345680
