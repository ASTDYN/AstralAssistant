generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(uuid())
  discordUserId           String   @unique
  discordUsernameSnapshot String?
  rsiHandle               String?  @unique
  displayName             String?
  timezone                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberProfile     MemberProfile?
  applications      Application[]

  adminNotesAbout   AdminNote[]    @relation("AdminNoteSubject")
  adminNotesCreated AdminNote[]    @relation("AdminNotesCreated")

  incidentsAsMember Incident[]     @relation("IncidentSubject")
  incidentsCreated  Incident[]     @relation("IncidentCreatedBy")

  warningsAsMember Warning[]       @relation("WarningSubject")
  warningsCreated  Warning[]       @relation("WarningCreatedBy")

  operationsCreated Operation[]    @relation("OperationCreatedBy")

  operationRsvps OperationRsvp[]    @relation("OperationRsvpParticipant")

  auditLogs AuditLog[]            @relation("AuditActor")
}

model MemberProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])

  status          MemberStatus @default(APPLIED)
  rankLabel       String?
  websiteRole     WebsiteRole  @default(USER)

  joinDate        DateTime?
  acceptedDate    DateTime?
  inactiveAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum MemberStatus {
  APPLIED
  NEEDS_REVIEW
  TRIAL_MEMBER
  ACCEPTED
  REJECTED
  INACTIVE
}

enum WebsiteRole {
  ADMIN
  USER
}

model Rank {
  id        String  @id @default(uuid())
  label     String  @unique
  sortOrder Int
  enabled   Boolean @default(true)
}

model InterestTag {
  id        String  @id @default(uuid())
  label     String
  slug      String  @unique
  enabled   Boolean @default(true)
  sortOrder Int
}

model Application {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  rsiHandle    String
  timezone     String?
  interests    String[]
  howFoundUs   String?
  alreadyInOrg Boolean?
  note         String?
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

enum ApplicationStatus {
  SUBMITTED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

model Operation {
  id                String          @id @default(uuid())
  title             String
  description       String?
  operationType     String
  startTimeUtc      DateTime
  stagingLocation   String?
  requiredRoles     String[]
  requiredShips     String[]
  maxParticipants   Int?
  voicePlan         String?
  briefingMarkdown  String?
  rulesOfEngagement String
  payoutModel       String
  status            OperationStatus @default(DRAFT)
  createdByUserId   String
  createdBy         User            @relation("OperationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  rsvps OperationRsvp[]

  @@index([startTimeUtc])
  @@index([status, startTimeUtc])
  @@index([createdByUserId])
}

enum OperationStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model OperationRsvp {
  id          String              @id @default(uuid())
  operationId String
  operation   Operation           @relation(fields: [operationId], references: [id])
  userId      String
  user        User                @relation("OperationRsvpParticipant", fields: [userId], references: [id])
  status      OperationRsvpStatus
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([operationId, userId])
  @@index([operationId])
  @@index([userId])
}

enum OperationRsvpStatus {
  JOINED
  LEFT
  WAITLISTED
}

model AdminNote {
  id              String        @id @default(uuid())
  memberUserId    String
  memberUser      User          @relation("AdminNoteSubject", fields: [memberUserId], references: [id])
  createdByUserId String
  createdBy       User          @relation("AdminNotesCreated", fields: [createdByUserId], references: [id])
  noteType        AdminNoteType
  body            String
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([memberUserId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([memberUserId, expiresAt])
}

enum AdminNoteType {
  GENERAL
  RECRUITING
  CONDUCT
  OPERATION
  ATTENDANCE
  LEADERSHIP
}

model Incident {
  id              String           @id @default(uuid())
  memberUserId    String
  memberUser      User             @relation("IncidentSubject", fields: [memberUserId], references: [id])
  createdByUserId String
  createdBy       User             @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id])
  title           String
  body            String
  severity        IncidentSeverity
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([memberUserId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([memberUserId, expiresAt])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

model Warning {
  id              String    @id @default(uuid())
  memberUserId    String
  memberUser      User      @relation("WarningSubject", fields: [memberUserId], references: [id])
  createdByUserId String
  createdBy       User      @relation("WarningCreatedBy", fields: [createdByUserId], references: [id])
  reason          String
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([memberUserId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([memberUserId, expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@index([targetType, targetId])
}
