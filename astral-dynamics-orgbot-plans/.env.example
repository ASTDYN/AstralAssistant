# App
NODE_ENV=development
APP_NAME=AstralDynamics OrgBot
ORG_NAME=AstralDynamics

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel placeholders - update later
DISCORD_ONBOARDING_CHANNEL_ID=
DISCORD_ADMIN_LOG_CHANNEL_ID=
DISCORD_OPS_CHANNEL_ID=
DISCORD_BOT_OUTPUT_CHANNEL_ID=
DISCORD_RULES_CHANNEL_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=

# Role placeholders - update later
DISCORD_ADMIN_ROLE_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_RECRUIT_ROLE_ID=
DISCORD_TRIAL_MEMBER_ROLE_ID=
DISCORD_BOT_MANAGER_ROLE_ID=

# Database
#
# Host development (PowerShell, npm, Prisma CLI, Nest on your machine):
# Use 127.0.0.1 so the URL matches docker compose port publish 127.0.0.1:5432→5432.
# The hostname `postgres` only resolves inside the Compose network, not on Windows.
#
# Docker Compose services `api` and `bot`:
# docker-compose.yml sets DATABASE_URL to postgresql://...@postgres:5432/... — that
# overrides this file for containers. You usually keep the line below as the host default.
#
DATABASE_URL=postgresql://astral:astral@127.0.0.1:5432/astral_dynamics?schema=public
#
# If you run Prisma ONLY inside a one-off container attached to the compose network
# (advanced), you would use the service hostname instead:
# DATABASE_URL=postgresql://astral:astral@postgres:5432/astral_dynamics?schema=public

# API
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Retention windows
RETENTION_WARNINGS_DAYS=30
RETENTION_INCIDENTS_DAYS=60
RETENTION_ADMIN_NOTES_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_APPLICATION_PRIVATE_NOTES_DAYS=90

# External data
ENABLE_SENTRY_LOOKUP=false
ENABLE_RSI_PUBLIC_LOOKUP=false
ENABLE_STAR_CITIZEN_WIKI_LOOKUP=true

# RAG / KB
ENABLE_RAG=true
KB_ROOT=./kb
